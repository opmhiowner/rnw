# Renewal Center (v0.1, one copy) - the Apache conf denies lib/ .git;
# this is the second lock.
DirectoryIndex index.php
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(lib|\.git|design|reference|launcher)(/|$) - [F,L]
  # pretty routes: /rnw/media  /rnw/comps  /rnw/prep  /rnw/post
  RewriteRule ^media/?$ media.php [L]
  RewriteRule ^comps/?$ comps.php [L]
  RewriteRule ^prep/?$ prep.php [L]
  RewriteRule ^post/?$ post.php [L]
</IfModule>

<FilesMatch "^(\.gitignore|\.htaccess|CLAUDE\.md|README.*)$">
  Require all denied
</FilesMatch>
<FilesMatch "\.(json|log|lock|sql|md)$">
  Require all denied
</FilesMatch>
